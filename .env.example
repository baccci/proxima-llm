# Proxima reads no API keys from the environment. Provider keys are entered in
# Settings → Providers and stored in the macOS Keychain.
#
# Copy this file to .env to set the optional values below. Bun loads .env on its own.

# Model used by `bun run eval`, as an OpenRouter model id. Leave commented out to
# use the default.
# EVAL_MODEL=google/gemini-3.5-flash
