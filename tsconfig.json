{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@shared/*": ["./src/shared-contracts/*"],
      "@/*": ["./src/mainview/*"],
      "@utils/*": ["./src/mainview/utils/*"],
      "@components/*": ["./src/mainview/components/*"],
      "@features/*": ["./src/mainview/features/*"],
      "@lib/*": ["./src/mainview/lib/*"],
      "@hooks/*": ["./src/mainview/hooks/*"],
      "@store/*": ["./src/mainview/store/*"],
      "@entities/*": ["./src/mainview/entities/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", ".electrobun"]
}
